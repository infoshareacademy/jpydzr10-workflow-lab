# =============================================================================
# Planer Maszyn Budowlanych — przykładowy plik konfiguracji środowiska
# =============================================================================
#
# Skopiuj ten plik jako `.env` w katalogu głównym projektu i uzupełnij wartości:
#     cp .env.example .env
#
# Plik `.env` jest w `.gitignore` — NIGDY nie commituj go do repozytorium.
#
# Wszystkie zmienne są wymagane przez `planer_config/settings/base.py`,
# chyba że zaznaczono "(opcjonalnie)".

# -----------------------------------------------------------------------------
# Django — sekret dla podpisywania sesji, CSRF tokenów, password resetów
# -----------------------------------------------------------------------------
# WYGENERUJ NOWY DLA KAŻDEGO ŚRODOWISKA:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=zmien-mnie-na-prawdziwy-sekret-50-znakow

# Lista hostów oddzielona przecinkami. W dev wystarczy localhost.
# W prod: prawdziwa domena (np. planer.firma.pl,www.planer.firma.pl)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# PostgreSQL 16 — uruchamiany przez docker-compose (OrbStack)
# -----------------------------------------------------------------------------
POSTGRES_DB=planer_kursowy
POSTGRES_USER=planer
POSTGRES_PASSWORD=zmien-mnie-na-mocne-haslo
POSTGRES_HOST=localhost
# Port 5434 (zamiast 5432) — port 5432 jest używany przez równolegle
# uruchomiony kontener innego lokalnego projektu (port 5432 zajęty).
POSTGRES_PORT=5434

# -----------------------------------------------------------------------------
# Email (opcjonalnie — w dev wszystkie maile lecą do konsoli)
# -----------------------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=twoj-adres@firma.pl
# EMAIL_HOST_PASSWORD=app-password-z-google
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@planer-maszyn.local
# SERVER_EMAIL=noreply@planer-maszyn.local
# Mailpit (dev — łapacz maili): EMAIL_HOST=localhost EMAIL_PORT=1025 EMAIL_USE_TLS=False

# -----------------------------------------------------------------------------
# Chatbot (W4 bonus, opcjonalnie)
# -----------------------------------------------------------------------------
# Klucz API dla Google Gemini (https://aistudio.google.com/apikey)
# Bez tej zmiennej chatbot zwraca komunikat "Asystent niedostępny" zamiast
# crashować — pozostałe funkcje aplikacji działają normalnie.
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Google Maps JavaScript API (widok /mapy/ BETA, opcjonalnie)
# -----------------------------------------------------------------------------
# Klucz API z Google Cloud Console (https://console.cloud.google.com/apis).
# Wymagane API w projekcie GCP: "Maps JavaScript API" + "Geocoding API".
# Bez klucza widok /mapy/ pokazuje panel informacyjny zamiast crashowac.
# Rekomendacja: zabezpiecz klucz przez HTTP referrer restriction
# (localhost:8002/* w dev, prawdziwa domena w prod).
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Uwierzytelnianie dwuskładnikowe (2FA / TOTP)
# -----------------------------------------------------------------------------
# Wymuszenie 2FA dla administratorów/kierowników/magazynierów. Domyślnie "1"
# (włączone). W lokalnym dev można ustawić "0", aby nie wymagać drugiego
# składnika podczas codziennej pracy.
# OTP_ENFORCE_2FA=1
# Hasło kont demonstracyjnych zakładanych przez `seed_demo` (opcjonalnie).
# DEMO_SEED_PASSWORD=

# -----------------------------------------------------------------------------
# Obserwowalność (GlitchTip / Sentry SDK, opcjonalnie)
# -----------------------------------------------------------------------------
# Bez SENTRY_DSN SDK nie jest inicjalizowany — aplikacja nie wysyła zdarzeń.
# DSN kopiujesz z GlitchTip po założeniu projektu (patrz docker-compose.glitchtip.yml).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0
# APP_RELEASE=m3-demo
# Konfiguracja kontenerów GlitchTip (używane przez docker-compose.glitchtip.yml):
# GLITCHTIP_SECRET_KEY=        # openssl rand -hex 32
# GLITCHTIP_DOMAIN=http://localhost:9000
# GLITCHTIP_DB_PASSWORD=
# GLITCHTIP_OPEN_REGISTRATION=True   # ustaw False po założeniu konta owner
