msgstr "2FA setup"

#: accounts/templates/accounts/2fa_setup.html:11
msgid "Włącz uwierzytelnianie dwuskładnikowe"
msgstr "Enable two-factor authentication"

#: accounts/templates/accounts/2fa_setup.html:14
msgid ""
"Zeskanuj kod QR w aplikacji typu Google Authenticator, a następnie wpisz "
"wygenerowany sześciocyfrowy kod."
msgstr ""
"Scan the QR code with an app such as Google Authenticator, then enter the "
"generated six-digit code."

#: accounts/templates/accounts/2fa_setup.html:24
msgid "Kod QR do konfiguracji 2FA"
msgstr "QR code for 2FA setup"

#: accounts/templates/accounts/2fa_setup.html:29
msgid "Klucz ręczny"
msgstr "Manual key"

#: accounts/templates/accounts/2fa_setup.html:37
msgid "Kod z aplikacji"
msgstr "Code from the app"

#: accounts/templates/accounts/2fa_setup.html:46
msgid "Potwierdź i włącz 2FA"
msgstr "Confirm and enable 2FA"

